{
 "version": "v1-draft",
 "status": "SPEC ONLY \u00b7 awaiting Creator revision \u00b7 no code written",
 "principle": "Rarity is a function of ACCESS, not dice. The habitat is the named event.",
 "rulings": {
  "territorialFailure": "OVERWORLD ACTION COMBAT \u2014 the Zyrex lunges on the map like a Mori. No transition.",
  "respawn": "Slow timer with a resident cap. Returning is worth it; camping is not.",
  "catchableTiers": "T1-T5 only. T6+ quest/event/ritual. Gemlords by RESPECT, never capture."
 },
 "catchLoop": [
  "spot",
  "approach (walk=quiet, sprint=loud)",
  "offer food (calm +1, max 3)",
  "open Zysphere (~1.5s astralite DNA sync)",
  "resolve by temperament"
 ],
 "chanceFormula": "clamp(BASE[tier] + (rizerBondTotal/3330)*30 + calm*8 + (quiet?10:0) - tempPenalty, 5, 95)",
 "temperaments": {
  "Skittish": {
   "onApproach": "flees if you sprint or make noise",
   "onFail": "flees immediately",
   "penalty": 0
  },
  "Wary": {
   "onApproach": "watches, backs away",
   "onFail": "flees after 2 failures",
   "penalty": 5
  },
  "Territorial": {
   "onApproach": "holds ground",
   "onFail": "ATTACKS \u00b7 overworld combat",
   "penalty": 15
  },
  "Dominant": {
   "onApproach": "attacks on sight",
   "onFail": "must be subdued first",
   "penalty": 30
  }
 },
