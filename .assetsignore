# ★ 2026-07-29 · Cloudflare Workers static-assets ignore list.  Same syntax
# as .gitignore.  Wrangler otherwise uploads .git/ pack files (100+ MB) and
# fails with "Asset too large" (25 MiB per-file cap).
.git/
.DS_Store
Thumbs.db
backups/
node_modules/
*.log
.wrangler/
# Skip the wrangler config itself + this ignore file (they're not site assets)
wrangler.jsonc
wrangler.toml
.assetsignore
# Editor / OS cruft
.vscode/
.idea/
.env
.env.*

# ★ 2026-10-06 · Not part of the website. The site deploys the whole repo, so
# without these lines the archive, drafts, handoffs and work files were public.
# Nothing here is loaded by any page (checked against every page before adding).
_archive/
tmp/
rp7d/
docs/
tools/
scripts/
backups/
data/_source/
*.md
*.txt
*.pdf
*.py
*.bak
*.psd
*.xlsx
*.zip
