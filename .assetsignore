# ★ 2026-07-29 · Cloudflare Workers static-assets ignore list.  Same syntax
# as .gitignore.  Wrangler otherwise uploads .git/ pack files (100+ MB) and
# fails with "Asset too large" (25 MiB per-file cap).
.git/
.DS_Store
Thumbs.db
backups/
node_modules/
*.log
.wrangler/
# Skip the wrangler config itself + this ignore file (they're not site assets)
wrangler.jsonc
wrangler.toml
.assetsignore
# Editor / OS cruft
.vscode/
.idea/
.env
.env.*

# ★ 2026-10-08 · RP7D's dev project (source, models, references, the 56 MB single-file playtest) is
# not part of the website and has files over the 25 MiB cap. The site serves the web build instead:
# play-rp7d/ (rebuilt with `node rp7d/tools/build_single_html.mjs --web`).
rp7d/
