#game.layout-editing .hud-panel{cursor:move}

/* ══ TITLE SCREEN · the key art, NEW GAME / LOAD GAME under the logo ══ */
.intro.title-screen{background:#05060d;overflow:hidden;display:block;z-index:8}
.title-stage{position:absolute;left:50%;top:50%;width:max(100vw,calc(100vh * 1672 / 941));aspect-ratio:1672/941;transform:translate(-50%,-50%)}
.title-art{position:absolute;inset:0;width:100%;height:100%;display:block;user-select:none;animation:titlein 1.6s ease-out both}
@keyframes titlein{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:none}}
.title-stage:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 60% 62%,transparent 30%,rgba(3,4,12,.35) 75%)}
.title-menu{position:absolute;left:60.3%;top:55.5%;transform:translateX(-50%);z-index:2;display:grid;gap:10px;width:clamp(240px,19vw,330px);animation:titlemenu .9s .7s ease-out both}
@keyframes titlemenu{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translateX(-50%)}}
.intro .title-btn{position:relative;margin:0;font-size:inherit;letter-spacing:normal;display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:12px;padding:11px 18px 11px 14px;text-align:left;cursor:pointer;
  color:#f5eedf;background:linear-gradient(160deg,rgba(14,20,40,.82),rgba(30,20,52,.82));border:1px solid #e9c98266;border-top:2px solid var(--gold);border-radius:10px;
  box-shadow:0 10px 26px #000b,inset 0 0 0 1px #ffffff08;backdrop-filter:blur(6px);transition:transform .18s,border-color .18s,box-shadow .18s,background .18s}
.intro .title-btn b{font:600 clamp(13px,1.05vw,17px) Cinzel,serif;letter-spacing:.2em}
.intro .title-btn small{grid-column:2;font:600 8px 'DM Sans',sans-serif;letter-spacing:.18em;color:#dfe6f08a;text-transform:uppercase;margin-top:2px}
.tb-gem{grid-row:1/3;width:12px;height:12px;transform:rotate(45deg);border:1px solid var(--gold);background:#0a1220;transition:.18s}
.intro .title-btn.focus,.intro .title-btn:hover{transform:translateX(6px);border-color:var(--gold);background:linear-gradient(160deg,rgba(24,36,72,.9),rgba(46,28,80,.9));box-shadow:0 10px 26px #000b,0 0 0 1px #e9c98255,0 0 22px #3f82ff55}
.intro .title-btn.focus .tb-gem,.intro .title-btn:hover .tb-gem{background:#3fa0ff;box-shadow:0 0 10px #3fa0ff}
.intro .title-btn:disabled{opacity:.45;cursor:default;transform:none}
.intro .title-btn:disabled .tb-gem{background:#0a1220;box-shadow:none}
.title-confirm{margin:2px 0 0;padding:8px 12px;font-size:11px;line-height:1.4;color:#ffd98a;background:rgba(10,12,24,.85);border-left:2px solid #ffd98a;border-radius:6px}
.title-confirm[hidden]{display:none}
.title-foot{position:absolute;left:0;right:0;bottom:18px;display:flex;justify-content:center;gap:26px;font:600 9px 'DM Sans',sans-serif;letter-spacing:.2em;color:#f5eedfb0;text-shadow:0 1px 6px #000}
.title-foot kbd{margin-right:6px}.title-ver{opacity:.6}
.intro.title-screen.hidden{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .8s,visibility .8s}

.intro .title-btn span.tb-gem{margin:0}

/* Title screen: no HUD until NEW GAME or LOAD GAME starts play (game.js beginPlay adds .playing). */
#game:not(.playing) > :not(#world):not(.vignette):not(#intro):not(#loading) { visibility: hidden !important; pointer-events: none !important; }

/* Zyphone · Armory: the wheel's six slots ringed round what's equipped, and the weapons owned */
.p-only{display:none}#game.pad .p-only{display:inline}
.zy-armory{display:grid;grid-template-columns:minmax(220px,260px) 1fr;gap:18px;align-items:start}
@media (max-width:760px){.zy-armory{grid-template-columns:1fr}}
.zy-ring{position:relative;width:240px;height:240px;margin:6px auto}
.zy-ring::before{content:"";position:absolute;inset:34px;border-radius:50%;border:1px solid #e9c9823a;box-shadow:inset 0 0 30px #39b8ff14}
.zy-slot{position:absolute;left:calc(50% + var(--x) * 88px - 29px);top:calc(50% + var(--y) * 88px - 29px);width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#0c1220d9;border:1px dashed #f1ebdd33;color:var(--ivory);cursor:pointer;padding:0}
.zy-slot.filled{border-style:solid;border-color:#e9c98266;cursor:grab}
.zy-slot i{width:34px;height:34px;display:block;color:#f4efe0}.zy-slot i svg,.zy-wicon svg,.zy-ring-core svg{width:100%;height:100%}
.zy-slot small{position:absolute;bottom:-4px;right:-2px;font-size:9px;background:#0c1220;border:1px solid #e9c98255;border-radius:8px;padding:0 5px;color:#ebe8d9aa}
.zy-slot.current{border-color:var(--gold);box-shadow:0 0 0 2px #e9c98244,0 0 18px #e9c98233}
.zy-slot.focus,.zy-slot:hover{border-color:var(--gold);background:#e9c98218}
.zy-slot.drop,#zy-weapons.drop{outline:2px dashed #7fe0ff;outline-offset:3px}
.zy-slot.moving,.zy-weapon.moving,.dragging{opacity:.45}
.zy-ring-core{position:absolute;left:50%;top:50%;width:112px;transform:translate(-50%,-50%);display:grid;justify-items:center;gap:3px;text-align:center}
.zy-ring-core svg{width:44px;height:44px;color:#f4efe0}
.zy-ring-core b{font:500 11px Cinzel,serif;color:var(--ivory);line-height:1.2}.zy-ring-core span{font-size:8px;letter-spacing:.16em;color:var(--gold)}
.zy-ring-core.carrying b{color:#7fe0ff}
.zy-weapon{cursor:grab}.zy-weapon .zy-wicon{flex:0 0 38px;width:38px;height:38px;color:#f4efe0}
.zy-weapon span{flex:1}.zy-tier{font-style:normal;font-size:9px;letter-spacing:.16em;color:#b58cff}
</style></head>
